
import express from "express";
import cors from "cors";
import OpenAI from "openai";

const app = express();
const port = process.env.PORT || 3000;

app.use(cors());
app.use(express.json({ limit: "20kb" }));

const client = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

app.get("/", (req, res) => {
  res.json({
    app: "Solusi AI",
    status: "online",
  });
});

app.post("/api/chat", async (req, res) => {
  try {
    const message = req.body?.message;

    if (typeof message !== "string" || !message.trim()) {
      return res.status(400).json({
        error: "Pesan tidak boleh kosong.",
      });
    }

    if (message.length > 4000) {
      return res.status(400).json({
        error: "Pesan maksimal 4000 karakter.",
      });
    }

    const response = await client.responses.create({
      model: process.env.OPENAI_MODEL || "gpt-5.5",
      instructions:
        "Kamu adalah Solusi AI, asisten yang ramah. " +
        "Jawab dalam bahasa yang digunakan pengguna. " +
        "Untuk pertanyaan coding, berikan penjelasan dan kode " +
        "yang jelas serta mudah dipahami.",
      input: message.trim(),
      max_output_tokens: 1000,
    });

    res.json({
      reply: response.output_text || "Maaf, belum ada jawaban.",
    });
  } catch (error) {
    console.error("Chat API error:", error.message);

    res.status(500).json({
      error: "Maaf, AI belum dapat menjawab. Coba lagi nanti.",
    });
  }
});

app.listen(port, "0.0.0.0", () => {
  console.log(`Solusi AI backend berjalan pada port ${port}`);
});
